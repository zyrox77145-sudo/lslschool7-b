rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidPeriodEntry(entry, expectedPeriod) {
      return entry is map
        && entry.period is number
        && entry.period == expectedPeriod
        && entry.time is string
        && entry.time.size() > 0
        && entry.time.size() <= 40
        && entry.subject is string
        && entry.subject.size() <= 120;
    }

    function isValidDaySchedule(dayList) {
      return dayList is list
        && dayList.size() == 8
        && isValidPeriodEntry(dayList[0], 1)
        && isValidPeriodEntry(dayList[7], 8);
    }

    function isValidClassSchedule(data) {
      return data.keys().hasAll([
          'Monday',
          'Tuesday',
          'Wednesday',
          'Thursday',
          'Friday',
          'Saturday',
          'Sunday',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'Monday',
          'Tuesday',
          'Wednesday',
          'Thursday',
          'Friday',
          'Saturday',
          'Sunday',
          'createdAt',
          'updatedAt'
        ])
        && isValidDaySchedule(data.Monday)
        && isValidDaySchedule(data.Tuesday)
        && isValidDaySchedule(data.Wednesday)
        && isValidDaySchedule(data.Thursday)
        && isValidDaySchedule(data.Friday)
        && isValidDaySchedule(data.Saturday)
        && isValidDaySchedule(data.Sunday)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /classSchedules/{scheduleId} {
      allow get: if isValidId(scheduleId) && scheduleId == 'class-7b';
      allow list: if false;
      allow create: if isValidId(scheduleId)
        && scheduleId == 'class-7b'
        && isValidClassSchedule(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(scheduleId)
        && scheduleId == 'class-7b'
        && isValidClassSchedule(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'Monday',
          'Tuesday',
          'Wednesday',
          'Thursday',
          'Friday',
          'Saturday',
          'Sunday',
          'updatedAt'
        ]);
      allow delete: if false;
    }
  }
}
